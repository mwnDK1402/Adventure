graph Rooms {
    label = "Adventure - Room Layout (dark)\nGold = starting room · Dashed red = locked door (none locked yet)";
    labelloc = t;
    fontname = "Helvetica";
    fontsize = 20;
    fontcolor = "#F0F0F0";
    bgcolor = "#1E1E1E";
    rankdir = TB;
    splines = ortho;
    node [shape = box, style = "rounded,filled", fontname = "Helvetica", fontsize = 14, fillcolor = "#2B2B2B", color = "#8A8A8A", fontcolor = "#F0F0F0"];
    edge [color = "#E0E0E0", penwidth = 1.5];

    { rank = same; r1; r2; r3; }
    { rank = same; r4; r5; r6; }
    { rank = same; r7; r8; r9; }

    r1 [label = "Room 1", fillcolor = "#4A3D18", color = "#E8C547"];
    r2 [label = <<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD>Room 2</TD></TR><TR><TD><FONT POINT-SIZE="11">Key, Lamp, Burger</FONT></TD></TR></TABLE>>];
    r3 [label = "Room 3"];
    r4 [label = <<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD>Room 4</TD></TR><TR><TD><FONT POINT-SIZE="11">Mushroom</FONT></TD></TR></TABLE>>];
    r5 [label = "Room 5"];
    r6 [label = "Room 6"];
    r7 [label = "Room 7"];
    r8 [label = "Room 8"];
    r9 [label = "Room 9"];

    // Room connections, mirroring Map.buildMap():
    //   room2.setWestEast(room1, room2)   -> r1 -- r2
    //   room1.setNorthSouth(room1, room4) -> r1 -- r4
    //   room3.setWestEast(room2, room3)   -> r2 -- r3
    //   room3.setNorthSouth(room3, room6) -> r3 -- r6
    //   room4.setNorthSouth(room4, room7) -> r4 -- r7
    //   room7.setWestEast(room7, room8)   -> r7 -- r8
    //   room5.setNorthSouth(room5, room8) -> r5 -- r8
    //   room8.setWestEast(room8, room9)   -> r8 -- r9
    //   room6.setNorthSouth(room6, room9) -> r6 -- r9
    r1 -- r2;
    r2 -- r3;
    r3 -- r6;
    r1 -- r4;
    r4 -- r7;
    r7 -- r8;
    r8 -- r9;
    r5 -- r8;
    r6 -- r9;

    // Locked doors: none active. Map.buildMap() keeps `room2.setLock(true)`
    // commented out. Note that Room.lock is per-room, not per-direction, so
    // enabling it blocks BOTH approaches to Room 2, not just the one from Room 1:
    //   r1 -- r2 [color = "#FF6B6B", style = "dashed", penwidth = 2.5];
    //   r2 -- r3 [color = "#FF6B6B", style = "dashed", penwidth = 2.5];

    // Invisible edges, used only to hold the grid layout
    edge [style = invis, color = "white"];
    r1 -- r4;
    r4 -- r7;
    r2 -- r5;
    r5 -- r8;
    r3 -- r6;
    r6 -- r9;
    r4 -- r5;
    r5 -- r6;
}
