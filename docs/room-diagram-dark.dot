graph Rooms {
    label = "Adventure - Room Layout (dark)\nGold = starting room · Dashed red = locked door";
    labelloc = t;
    fontname = "Helvetica";
    fontsize = 20;
    fontcolor = "#F0F0F0";
    bgcolor = "#1E1E1E";
    rankdir = TB;
    splines = ortho;
    node [shape = box, style = "rounded,filled", fontname = "Helvetica", fontsize = 14, fillcolor = "#2B2B2B", color = "#8A8A8A", fontcolor = "#F0F0F0"];
    edge [color = "#E0E0E0", penwidth = 1.5];

    { rank = same; r1; r2; r3; }
    { rank = same; r4; r5; r6; }
    { rank = same; r7; r8; r9; }

    r1 [label = <<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD>Room 1</TD></TR><TR><TD><FONT POINT-SIZE="11">Backpack, Wooden sword</FONT></TD></TR></TABLE>>, fillcolor = "#4A3D18", color = "#E8C547"];
    r2 [label = <<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD>Room 2</TD></TR><TR><TD><FONT POINT-SIZE="11">Key, Lamp, Canned beans</FONT></TD></TR></TABLE>>];
    r3 [label = <<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD>Room 3</TD></TR><TR><TD><FONT POINT-SIZE="11">Rope, Slingshot, Trail mix</FONT></TD></TR></TABLE>>];
    r4 [label = <<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD>Room 4</TD></TR><TR><TD><FONT POINT-SIZE="11">Torch, Mushroom</FONT></TD></TR></TABLE>>];
    r5 [label = "Room 5"];
    r6 [label = <<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD>Room 6</TD></TR><TR><TD><FONT POINT-SIZE="11">Hook, Fish</FONT></TD></TR></TABLE>>];
    r7 [label = <<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD>Room 7</TD></TR><TR><TD><FONT POINT-SIZE="11">Dried meat, Bone club</FONT></TD></TR></TABLE>>];
    r8 [label = <<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD>Room 8</TD></TR><TR><TD><FONT POINT-SIZE="11">Ancient Key, Stone fist</FONT></TD></TR></TABLE>>];
    r9 [label = <<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD>Room 9</TD></TR><TR><TD><FONT POINT-SIZE="11">Steel sword, Energy bar</FONT></TD></TR></TABLE>>];

    // Room connections, mirroring Map.buildMap():
    //   room2.setWestEast(room1, room2)   -> r1 -- r2
    //   room1.setNorthSouth(room1, room4) -> r1 -- r4
    //   room3.setWestEast(room2, room3)   -> r2 -- r3
    //   room3.setNorthSouth(room3, room6) -> r3 -- r6
    //   room4.setNorthSouth(room4, room7) -> r4 -- r7
    //   room7.setWestEast(room7, room8)   -> r7 -- r8
    //   room5.setNorthSouth(room5, room8) -> r5 -- r8
    //   room8.setWestEast(room8, room9)   -> r8 -- r9
    //   room6.setNorthSouth(room6, room9) -> r6 -- r9
    // Locked doors: Map.buildMap() calls `room2.setLock(true)`, so Room 2 is
    // locked and both edges leading to it are drawn dashed red. Note that
    // Room.lock is per-room, not per-direction, so the lock blocks BOTH
    // approaches to Room 2, not just the one from Room 1.
    r1 -- r2 [color = "#FF6B6B", style = "dashed", penwidth = 2.5];
    r2 -- r3 [color = "#FF6B6B", style = "dashed", penwidth = 2.5];
    r3 -- r6;
    r1 -- r4;
    r4 -- r7;
    r7 -- r8;
    r8 -- r9;
    r5 -- r8;
    r6 -- r9;

    // Invisible edges, used only to hold the grid layout
    edge [style = invis, color = "white"];
    r1 -- r4;
    r4 -- r7;
    r2 -- r5;
    r5 -- r8;
    r3 -- r6;
    r6 -- r9;
    r4 -- r5;
    r5 -- r6;
}
