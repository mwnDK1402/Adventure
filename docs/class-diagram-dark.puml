@startuml
title Adventure - Class Diagram (dark)

skinparam {
    backgroundColor #1E1E1E
    ArrowColor #E0E0E0
    ClassBackgroundColor #2B2B2B
    ClassBorderColor #8A8A8A
    ClassFontColor #F0F0F0
    ClassAttributeFontColor #C8C8C8
    ClassAttributeIconColor #F0F0F0
    ClassStereotypeFontColor #C8C8C8
    EnumBackgroundColor #2B2B2B
    EnumBorderColor #8A8A8A
    EnumFontColor #F0F0F0
    EnumTitleFontColor #F0F0F0
    TitleFontColor #F0F0F0
    DefaultFontColor #F0F0F0
}

class Room {
    - name : String
    - description : String
    - lock : boolean
    - items : ArrayList<Item>
    - enemies : ArrayList<Enemy>
    - north : Room
    - south : Room
    - east : Room
    - west : Room
    + Room(name : String, description : String)
    + getName() : String
    + getDescription() : String
    + getLock() : boolean
    + setLock(bool : boolean) : void
    + getNorth() : Room
    + getSouth() : Room
    + getEast() : Room
    + getWest() : Room
    + setNorth(room : Room) : void
    + setSouth(room : Room) : void
    + setEast(room : Room) : void
    + setWest(room : Room) : void
    + setNorthSouth(north : Room, south : Room) : void
    + setWestEast(west : Room, east : Room) : void
    + addItem(item : Item) : void
    + removeItem(item : Item) : boolean
    + getItems() : ArrayList<Item>
    + findItem(shortName : String) : Item
    + addEnemy(enemy : Enemy) : void
    + removeEnemy(enemy : Enemy) : void
    + getEnemies() : ArrayList<Enemy>
    + findEnemy(shortName : String) : Enemy
    + getEnemySize() : int
    + getAnyEnemy() : Enemy
}

class Enemy {
    - shortName : String
    - longName : String
    - description : String
    - weapon : Weapon
    - room : Room
    - health : int
    + Enemy(shortName : String, longName : String, description : String, health : int, weapon : Weapon, room : Room)
    + attack(player : Player) : EnemyAttackOutcome
    + hit(damage : int) : void
    + isAlive() : boolean
    + getShortName() : String
    + getDescription() : String
    + getLongName() : String
    + getEnemyHealth() : int
    + getWeapon() : Weapon
}

class Player {
    - currentRoom : Room
    - isLocked : boolean
    - inventory : ArrayList<Item>
    - health : int
    - equipped : Weapon
    + Player(currentRoom : Room, health : int)
    + getCurrentRoom() : Room
    + move(direction : String) : boolean
    + isLocked() : boolean
    + getInventory() : ArrayList<Item>
    + takeItem(intendedItem : String) : boolean
    + dropItem(intendedItem : String) : boolean
    + getHealth() : int
    + eat(shortName : String) : EatOutcome
    + equip(shortName : String) : EquipResult
    + getEquipped() : Weapon
    + attack(enemy : Enemy) : PlayerAttackOutcome
    + hit(damage : int) : void
    + hasKey() : boolean
    + unlock(direction : String) : boolean
    - findItem(shortName : String) : Item
}

class Adventure {
    - player : Player
    - map : Map
    + Adventure()
    + look() : String
    + getRoomName() : String
    + go(direction : String) : boolean
    + roomIsLocked() : boolean
    + inventory() : String
    + take(shortName : String) : boolean
    + drop(shortName : String) : boolean
    + health() : int
    + eat(shortName : String) : EatOutcome
    + equip(shortName : String) : EquipResult
    + attack(shortName : String) : CombatOutcome
    + playerHasKey() : boolean
    + unlock(direction : String) : boolean
    - enemiesInRoom() : String
    - itemsInRoom() : String
}

class Map {
    - initialRoom : Room
    + buildMap() : void
    + getInitialRoom() : Room
}

class Item {
    - shortName : String
    - longName : String
    + Item(shortName : String, longName : String)
    + getInventoryText() : String
    + getLongName() : String
}

class Food {
    - healthPoints : int
    + Food(shortName : String, longName : String, healthPoints : int)
    + getHealthPoints() : int
}

abstract class Weapon {
    - damage : int
    + Weapon(shortName : String, longName : String, damage : int)
    + {abstract} canUse() : boolean
    + {abstract} use() : void
    + {abstract} getCannotUseMessage() : String
    + {abstract} getAttackVerb() : String
    + {abstract} getUsesLeft() : int
    + getDamage() : int
}

class MeleeWeapon {
    + MeleeWeapon(shortName : String, longName : String, damage : int)
    + canUse() : boolean
    + use() : void
    + getCannotUseMessage() : String
    + getAttackVerb() : String
    + getUsesLeft() : int
}

class RangedWeapon {
    - ammunition : int
    + RangedWeapon(shortName : String, longName : String, damage : int, ammunition : int)
    + canUse() : boolean
    + use() : void
    + getCannotUseMessage() : String
    + getAttackVerb() : String
    + getUsesLeft() : int
}

class EatOutcome {
    - result : EatResult
    - healthChange : int
    - healthPostFood : int
    - enemyOutcome : EnemyAttackOutcome
    + EatOutcome(result : EatResult, healthChange : int, enemyOutcome : EnemyAttackOutcome, healthPostFood : int)
    + getResult() : EatResult
    + getHealthChange() : int
    + getEnemyOutcome() : EnemyAttackOutcome
    + getHealthPostFood() : int
    + isPlayerAlive() : boolean
}

enum EatResult {
    NOT_FOUND
    NOT_FOOD
    EATEN
}

class PlayerAttackOutcome {
    - result : AttackResult
    - playerDamageDealt : int
    - message : String
    - playerAttackVerb : String
    - usesLeft : int
    - enemyHealth : int
    - enemyLongName : String
    + PlayerAttackOutcome(result : AttackResult, playerDamageDealt : int, message : String, attackVerb : String, usesLeft : int, enemyHealth : int, enemyLongName : String)
    + getResult() : AttackResult
    + getMessage() : String
    + getAttackVerb() : String
    + getUsesLeft() : int
    + getEnemyHealthOutcome() : int
    + getEnemyLongName() : String
    + getPlayerDamageDealt() : int
    + isEnemyAlive() : boolean
}

class EnemyAttackOutcome {
    - enemyDamageDealt : int
    - playerHealth : int
    - enemyAttackVerb : String
    - enemyLongName : String
    + EnemyAttackOutcome(enemyDamageDealt : int, playerHealth : int, enemyAttackVerb : String, enemyLongName : String)
    + getEnemyAttackVerb() : String
    + getEnemyDamageDealt() : int
    + getPlayerHealth() : int
    + getEnemyLongName() : String
    + isPlayerAlive() : boolean
}

class CombatOutcome {
    - enemyAttackOutcome : EnemyAttackOutcome
    - playerAttackOutcome : PlayerAttackOutcome
    + CombatOutcome(playerAttackOutcome : PlayerAttackOutcome, enemyAttackOutcome : EnemyAttackOutcome)
    + getEnemy() : EnemyAttackOutcome
    + getPlayer() : PlayerAttackOutcome
}

enum AttackResult {
    NO_WEAPON
    CANNOT_USE
    ATTACKED
    NO_ENEMY
}

enum EquipResult {
    NOT_EQUIPMENT
    NOT_FOUND
    EQUIPPED
}

enum Command {
    Invalid
    Go
    Look
    Help
    Exit
    Inventory
    Health
    Attack
    Eat
    Drop
    Take
    Equip
    + {static} validate(command : String) : Command
}

enum Direction {
    North
    South
    East
    West
    + {static} validate(direction : String) : Direction
}

class InputLine {
    - command : String
    - arg : String
    + InputLine(inputLine : String)
    + getCommand() : String
    + getArg() : String
}

class UserInterface {
    - scanner : Scanner
    - adventure : Adventure
    - running : boolean
    + start() : void
    - {static} handleInvalid() : void
    - handleHelp() : void
    - handleExit() : void
    - handleInventory() : void
    - handleHealth() : void
    - handleEquip(intendedWeapon : String) : void
    - handleTake(intendedItem : String) : void
    - handleDrop(intendedItem : String) : void
    - handleEat(intendedFood : String) : void
    - handleAttack(intendedEnemy : String) : void
    - handleLook() : void
    - handleGo(direction : Direction) : void
    - askYesNo(question : String) : boolean
    - handleGameOver() : void
    - {static} printEnemyAttack(outcome : EnemyAttackOutcome) : void
}

class Main {
    + {static} main(args : String[]) : void
}

Main ..> UserInterface : <<creates>>
UserInterface "1" o-- "1" Adventure : adventure
Adventure "1" o-- "1" Player : player
Adventure "1" *-- "1" Map : map
Map "1" *-- "9" Room : buildMap()
Player "1" o-- "1" Room : currentRoom
Room "0..4" o-- "0..4" Room : north / south / east / west
Room "1" o-- "0..*" Item : items
Room "1" o-- "0..*" Enemy : enemies
Enemy "0..*" o-- "1" Room : room
Enemy "1" o-- "1" Weapon : weapon
Player "1" o-- "0..*" Item : inventory
Player "1" o-- "0..1" Weapon : equipped
Food --|> Item
Weapon --|> Item
MeleeWeapon --|> Weapon
RangedWeapon --|> Weapon
Player ..> Food : <<uses>>
Player ..> EatOutcome : <<creates>>
EatOutcome "1" o-- "1" EatResult : result
EatOutcome "1" o-- "0..1" EnemyAttackOutcome : enemyOutcome
Player ..> PlayerAttackOutcome : <<creates>>
PlayerAttackOutcome "1" o-- "1" AttackResult : result
Adventure ..> CombatOutcome : <<creates>>
CombatOutcome "1" o-- "1" PlayerAttackOutcome : playerAttackOutcome
CombatOutcome "1" o-- "0..1" EnemyAttackOutcome : enemyAttackOutcome
Enemy ..> EnemyAttackOutcome : <<creates>>
Player ..> Enemy : <<uses>>
Enemy ..> Player : <<uses>>
UserInterface ..> InputLine : <<creates>>
UserInterface ..> Command : <<uses>>
UserInterface ..> Direction : <<uses>>
InputLine ..> Direction : <<uses>>
UserInterface ..> Scanner : <<uses>>
Adventure ..> ArrayList : <<uses>>
Player ..> ArrayList : <<uses>>
Room ..> ArrayList : <<uses>>

@enduml
